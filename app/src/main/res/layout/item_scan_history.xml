<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/historyCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="#FFFFFF">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Status Badge -->
        <TextView
            android:id="@+id/statusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Approved"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/status_badge_bg"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Reservation ID -->
        <TextView
            android:id="@+id/tvReservationId"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="RES-001"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#1A1A2E"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/statusBadge"
            android:layout_marginEnd="8dp" />

        <!-- Station ID -->
        <TextView
            android:id="@+id/tvStationId"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Station: STN-045"
            android:textSize="12sp"
            android:textColor="#6C757D"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toBottomOf="@id/tvReservationId"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Time Slot Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/timeSlotCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardBackgroundColor="#F0F8FF"
            app:cardElevation="0dp"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/tvStationId">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="12dp"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@android:drawable/ic_menu_recent_history"
                    android:tint="#2196F3" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">

                    <TextView
                        android:id="@+id/tvTimeSlot"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="12:30 - 13:30"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#1565C0" />

                    <TextView
                        android:id="@+id/tvStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="In Progress"
                        android:textSize="11sp"
                        android:textColor="#1976D2"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Scan Info -->
        <LinearLayout
            android:id="@+id/scanInfoLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/timeSlotCard">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@android:drawable/ic_menu_day"
                android:tint="#6C757D" />

            <TextView
                android:id="@+id/tvDateScanned"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Oct 12, 2025"
                android:textSize="12sp"
                android:textColor="#6C757D"
                android:layout_marginStart="8dp" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@android:drawable/ic_menu_recent_history"
                android:tint="#6C757D"
                android:layout_marginStart="16dp" />

            <TextView
                android:id="@+id/tvTimeScanned"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Scanned at 12:25:30"
                android:textSize="12sp"
                android:textColor="#6C757D"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <!-- Action Buttons -->
        <LinearLayout
            android:id="@+id/actionButtonsLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/scanInfoLayout">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnComplete"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Complete"
                android:textSize="13sp"
                app:icon="@android:drawable/ic_menu_upload"
                app:iconSize="18dp"
                app:iconGravity="textStart"
                app:cornerRadius="10dp"
                app:backgroundTint="#4CAF50"
                android:layout_marginEnd="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancel"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Cancel"
                android:textSize="13sp"
                app:icon="@android:drawable/ic_menu_close_clear_cancel"
                app:iconSize="18dp"
                app:iconGravity="textStart"
                app:cornerRadius="10dp"
                app:backgroundTint="#F44336"
                style="@style/Widget.Material3.Button.OutlinedButton"
                app:strokeColor="#F44336"
                android:textColor="#F44336"
                android:layout_marginStart="8dp" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
