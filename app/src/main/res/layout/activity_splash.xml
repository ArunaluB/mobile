<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_primary">

    <!-- Neon glow effect background -->
    <View
        android:id="@+id/glowEffect"
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:background="@drawable/gradient_green_card"
        android:alpha="0.15"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/appNameText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⚡ RechangeMe"
        android:textSize="38sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:fontFamily="sans-serif-black"
        android:letterSpacing="0.05"
        android:alpha="0"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/lottieAnimation"
        app:layout_constraintVertical_chainStyle="packed" />

    <TextView
        android:id="@+id/appSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="EV Hub Charging"
        android:textSize="16sp"
        android:textColor="@color/primary"
        android:fontFamily="sans-serif-medium"
        android:alpha="0"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/appNameText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/lottieAnimation"
        android:layout_width="250dp"
        android:layout_height="250dp"
        app:lottie_rawRes="@raw/splash_animation"
        app:lottie_autoPlay="true"
        app:lottie_loop="true"
        android:alpha="0"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/appSubtitle"
        app:layout_constraintBottom_toTopOf="@id/designerText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Loading indicator -->
    <LinearLayout
        android:id="@+id/loadingLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:alpha="0"
        app:layout_constraintTop_toBottomOf="@id/lottieAnimation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp">

        <ProgressBar
            android:id="@+id/loadingProgress"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:indeterminateTint="@color/primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Initializing..."
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:layout_marginStart="12dp" />

    </LinearLayout>

    <TextView
        android:id="@+id/designerText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Designed by Arunalu Bamunusinghe"
        android:textSize="13sp"
        android:textColor="@color/text_tertiary"
        android:fontFamily="sans-serif-light"
        android:alpha="0"
        android:layout_marginBottom="40dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/loadingLayout" />

    <!-- Accent line at bottom -->
    <View
        android:layout_width="80dp"
        android:layout_height="4dp"
        android:background="@drawable/button_primary_gradient"
        android:alpha="0"
        android:layout_marginBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>